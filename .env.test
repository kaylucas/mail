# =============================================================================
# Test Environment Configuration for CircleCI
# =============================================================================
# This file is used by CircleCI test runs. It provides a minimal configuration
# optimized for CI testing with in-memory drivers where possible.
# =============================================================================

APP_NAME=Mail
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration (MariaDB in CI)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing
DB_USERNAME=root
DB_PASSWORD=password

# -----------------------------------------------------------------------------
# Session and Cache (in-memory for tests)
# -----------------------------------------------------------------------------
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

# -----------------------------------------------------------------------------
# Mail (log for tests)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Sanctum Configuration
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost

# -----------------------------------------------------------------------------
# Microsoft Office365 (dummy values for tests)
# -----------------------------------------------------------------------------
OFFICE365_TENANT_ID=test-tenant
OFFICE365_CLIENT_ID=test-client-id
OFFICE365_CLIENT_SECRET=test-client-secret
OFFICE365_REDIRECT_URI=http://localhost/auth/microsoft/callback
OFFICE365_SCOPES="openid,profile,email"

# -----------------------------------------------------------------------------
# Microsoft Graph Webhook (dummy values for tests)
# -----------------------------------------------------------------------------
WEBHOOK_BASE_URL=http://localhost
WEBHOOK_SECRET_KEY=test-webhook-secret-key-for-ci-testing
GRAPH_SUBSCRIPTION_EXPIRATION_MINUTES=10080
GRAPH_SUBSCRIPTION_RENEWAL_THRESHOLD_HOURS=12

# -----------------------------------------------------------------------------
# AI Provider (dummy values for tests)
# -----------------------------------------------------------------------------
PRISM_PROVIDER=anthropic
ANTHROPIC_API_KEY=test-anthropic-key
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Email Rules
# -----------------------------------------------------------------------------
EMAIL_RULES_ENABLED=true
EMAIL_RULES_QUEUE=sync
