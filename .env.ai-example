# AI Provider Configuration (Prism)
# =====================================
# Choose your AI provider: 'openai', 'anthropic', or 'gemini'
PRISM_PROVIDER=openai

# OpenAI Configuration
# --------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=30

# Anthropic Configuration (Optional - only if using Anthropic)
# -------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_VERSION=2023-06-01
# ANTHROPIC_TEMPERATURE=0.7
# ANTHROPIC_MAX_TOKENS=2000
# ANTHROPIC_TIMEOUT=30

# Google Gemini Configuration (Optional - only if using Gemini)
# -------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-pro
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=2000
# GEMINI_TIMEOUT=30
