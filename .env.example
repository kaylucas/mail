APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Backend URL (Traefik domain)
# For ngrok tunnel (OAuth testing):
APP_URL=https://aery.eu.ngrok.io
# For local development without OAuth:
# APP_URL=http://mail.loc

# Frontend URL (separate Vue SPA)
# Development: Vite dev server
FRONTEND_URL=http://localhost:5173
# Production: Your frontend deployment URL
# FRONTEND_URL=https://your-frontend-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MariaDB 10.11)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=mail
DB_USERNAME=mail_user
DB_PASSWORD=secret

FORWARD_DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to null for cross-origin development
SESSION_DOMAIN=null
# Session Cookie Security
# Set to false for local HTTP development (http://mail.loc)
# Even when using ngrok HTTPS for OAuth, the app itself runs on HTTP locally
# In production with full HTTPS, set to true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Development Setup
# Backend: Docker + Traefik at http://mail.loc
# Frontend: Local pnpm dev server at http://localhost:5173
# Add to /etc/hosts: 127.0.0.1 mail.loc

# Include localhost:5173 for local Vite dev server
SANCTUM_STATEFUL_DOMAINS=localhost:5173,mail.loc,localhost,127.0.0.1,aery.eu.ngrok.io

# Frontend dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://aery.eu.ngrok.io

# Microsoft SSO Configuration
# These credentials are used for Microsoft OAuth authentication and Office365 integration
# Obtain these values from Azure AD App Registration: https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
OFFICE365_TENANT_ID=common
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
# OAuth Redirect URI
# For local development with ngrok tunnel: https://aery.eu.ngrok.io/auth/microsoft/callback
# For direct local testing (won't work with Microsoft OAuth): http://mail.loc/auth/microsoft/callback
# The ngrok tunnel forwards external OAuth callbacks to the local application
# Use ngrok tunnel URL for Microsoft OAuth to work:
OFFICE365_REDIRECT_URI=https://aery.eu.ngrok.io/auth/microsoft/callback
# Or use local URL (OAuth won't work, but app will run):
# OFFICE365_REDIRECT_URI=http://mail.loc/auth/microsoft/callback
OFFICE365_SCOPES="openid,profile,email,offline_access,User.Read,Mail.Read"

# IMPORTANT: ngrok OAuth Configuration
# When testing Microsoft OAuth with ngrok:
# 1. Set APP_URL=https://aery.eu.ngrok.io (for OAuth redirect URI generation)
# 2. Set SESSION_SECURE_COOKIE=false (CRITICAL - app runs on HTTP at mail.loc)
# 3. Start ngrok: ngrok http --domain=aery.eu.ngrok.io --host-header=rewrite mail.loc:80
# 4. Run: composer install (to ensure Microsoft Graph SDK is installed)
# 5. Access app at: http://mail.loc (NOT localhost:5173)
#
# Why SESSION_SECURE_COOKIE=false even with ngrok HTTPS?
# - OAuth callback happens over HTTPS (ngrok) ✓
# - Session is created and stored in database ✓
# - User is redirected to http://mail.loc (HTTP) ✓
# - All subsequent requests happen over HTTP at mail.loc
# - Browsers won't send cookies marked 'Secure' over HTTP connections
# - Result: API calls fail with "Unauthenticated" even though session exists
#
# The Vite dev server at localhost:5173 is for hot-reload only.
# Always access the application at http://mail.loc
#
# When developing locally without OAuth:
# 1. Set APP_URL=http://mail.loc
# 2. Set SESSION_SECURE_COOKIE=false
# 3. OAuth login will not work, but the rest of the app will
#
# Trusted Proxies:
# The application is configured to trust all proxies (*) by default.
# This is required for ngrok to properly forward request headers.
# Laravel will trust X-Forwarded-* headers from ngrok to maintain sessions.
# Configuration is in bootstrap/app.php and app/Http/Middleware/TrustProxies.php
#
# See NGROK_SETUP.md for detailed instructions
