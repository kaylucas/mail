APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Backend URL (Traefik domain)
# Default: Local development without OAuth
APP_URL=http://mail.loc
# For Microsoft OAuth testing with ngrok tunnel, use:
# APP_URL=https://aery.eu.ngrok.io
# (See NGROK_SETUP.md for complete OAuth setup instructions)

# Frontend URL (separate Vue SPA)
# Development: Vite dev server
FRONTEND_URL=http://localhost:5173
# Production: Your frontend deployment URL
# FRONTEND_URL=https://your-frontend-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MariaDB 10.11)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=mail
DB_USERNAME=mail_user
DB_PASSWORD=secret

FORWARD_DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Development Setup
# Backend: Docker + Traefik at http://mail.loc
# Frontend: Standalone Vue SPA at http://localhost:5173
# Authentication: Token-based (stored in localStorage)
# Add to /etc/hosts: 127.0.0.1 mail.loc

# Sanctum configuration (kept for compatibility, but using token-based auth)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,mail.loc,localhost,127.0.0.1,aery.eu.ngrok.io

# Frontend origin for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://aery.eu.ngrok.io

# Microsoft SSO Configuration
# These credentials are used for Microsoft OAuth authentication and Office365 integration
# Obtain these values from Azure AD App Registration: https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
OFFICE365_TENANT_ID=common
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
# OAuth Redirect URI
# For local development with ngrok tunnel: https://aery.eu.ngrok.io/auth/microsoft/callback
# For direct local testing (won't work with Microsoft OAuth): http://mail.loc/auth/microsoft/callback
# The ngrok tunnel forwards external OAuth callbacks to the local application
# Use ngrok tunnel URL for Microsoft OAuth to work:
OFFICE365_REDIRECT_URI=https://aery.eu.ngrok.io/auth/microsoft/callback
# Or use local URL (OAuth won't work, but app will run):
# OFFICE365_REDIRECT_URI=http://mail.loc/auth/microsoft/callback
OFFICE365_SCOPES="openid,profile,email,offline_access,User.Read,Mail.Read"

# Microsoft Graph Webhook Configuration
# Webhooks enable real-time notifications when emails change (created, updated, deleted)
# Requires publicly accessible HTTPS endpoint - use ngrok for local testing

# Webhook base URL - must be publicly accessible HTTPS
# Local development with ngrok (same tunnel as OAuth):
WEBHOOK_BASE_URL=https://aery.eu.ngrok.io
# Production deployment:
# WEBHOOK_BASE_URL=https://mail.example.com
# Local without webhooks (webhooks won't work):
# WEBHOOK_BASE_URL=http://mail.loc

# Webhook secret key for clientState validation
# Protects against spoofed notifications from malicious sources
# Generate with: docker-compose exec app php artisan tinker
# Then run: Str::random(32)
# Example output: 8f7d9e6c5b4a3f2e1d0c9b8a7f6e5d4c
WEBHOOK_SECRET_KEY=your-secure-random-string-here

# Subscription expiration time in minutes
# Maximum for mail resources: 10,080 minutes (7 days)
# Minimum: 45 minutes (Microsoft auto-bumps if lower)
# Default: 10,080 minutes (7 days)
# Subscriptions will auto-renew before expiration via scheduled job
GRAPH_SUBSCRIPTION_EXPIRATION_MINUTES=10080

# Subscription renewal threshold in hours
# Subscriptions expiring within this threshold will be renewed
# Recommended: 12 hours to ensure no gaps in notification delivery
# Scheduled job checks this threshold and renews proactively
GRAPH_SUBSCRIPTION_RENEWAL_THRESHOLD_HOURS=12

# Quick webhook testing setup:
# 1. Start ngrok tunnel:
#    ngrok http --domain=aery.eu.ngrok.io --host-header=rewrite mail.loc:80
#
# 2. Generate webhook secret (run in tinker):
#    Str::random(32)
#
# 3. Set environment variables (this file):
#    WEBHOOK_BASE_URL=https://aery.eu.ngrok.io
#    WEBHOOK_SECRET_KEY=<paste-generated-secret>
#
# 4. Restart application:
#    docker-compose restart app
#    docker-compose exec app php artisan config:clear
#
# 5. Start queue worker:
#    docker-compose exec app php artisan queue:work --queue=notifications,default
#
# 6. Create subscription via API:
#    curl -X POST http://mail.loc/api/subscriptions \
#      -H "Authorization: Bearer YOUR_TOKEN"
#
# For detailed instructions, see: docs/WEBHOOK_LOCAL_TESTING.md

# IMPORTANT: ngrok OAuth Configuration
# When testing Microsoft OAuth with ngrok:
# 1. Set APP_URL=https://aery.eu.ngrok.io (for OAuth redirect URI generation)
# 2. Set SESSION_SECURE_COOKIE=false (CRITICAL - app runs on HTTP at mail.loc)
# 3. Start ngrok: ngrok http --domain=aery.eu.ngrok.io --host-header=rewrite mail.loc:80
# 4. Run: composer install (to ensure Microsoft Graph SDK is installed)
# 5. Access app at: http://mail.loc (NOT localhost:5173)
#
# Why SESSION_SECURE_COOKIE=false even with ngrok HTTPS?
# - OAuth callback happens over HTTPS (ngrok) ✓
# - Session is created and stored in database ✓
# - User is redirected to http://mail.loc (HTTP) ✓
# - All subsequent requests happen over HTTP at mail.loc
# - Browsers won't send cookies marked 'Secure' over HTTP connections
# - Result: API calls fail with "Unauthenticated" even though session exists
#
# The Vite dev server at localhost:5173 is for hot-reload only.
# Always access the application at http://mail.loc
#
# When developing locally without OAuth:
# 1. Set APP_URL=http://mail.loc
# 2. Set SESSION_SECURE_COOKIE=false
# 3. OAuth login will not work, but the rest of the app will
#
# Trusted Proxies:
# The application is configured to trust all proxies (*) by default.
# This is required for ngrok to properly forward request headers.
# Laravel will trust X-Forwarded-* headers from ngrok to maintain sessions.
# Configuration is in bootstrap/app.php and app/Http/Middleware/TrustProxies.php
#
# See NGROK_SETUP.md for detailed instructions

# AI-Powered Email Rules Configuration
# Supports multiple providers: anthropic, openai, gemini
PRISM_PROVIDER=anthropic

# AI Provider API Keys (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email Rules Feature
EMAIL_RULES_ENABLED=true
EMAIL_RULES_QUEUE=email-rules
EMAIL_REMINDER_CHECK_TIME=09:00
