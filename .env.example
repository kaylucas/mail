APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Backend URL (Traefik domain)
APP_URL=http://mail.loc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MariaDB 10.11)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=mail
DB_USERNAME=mail_user
DB_PASSWORD=secret

FORWARD_DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to null for cross-origin development
SESSION_DOMAIN=null
# Set to false for HTTP development, true for HTTPS production
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Development Setup
# Backend: Docker + Traefik at http://mail.loc
# Frontend: Local pnpm dev server at http://localhost:5173
# Add to /etc/hosts: 127.0.0.1 mail.loc

# Include localhost:5173 for local Vite dev server
SANCTUM_STATEFUL_DOMAINS=localhost:5173,mail.loc,localhost,127.0.0.1

# Frontend dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Microsoft SSO Configuration
# These credentials are used for Microsoft OAuth authentication and Office365 integration
# Obtain these values from Azure AD App Registration: https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
OFFICE365_TENANT_ID=common
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
# OAuth Redirect URI
# For local development with ngrok tunnel: https://aery.eu.ngrok.io/auth/microsoft/callback
# For direct local testing (won't work with Microsoft OAuth): http://mail.loc/auth/microsoft/callback
# The ngrok tunnel forwards external OAuth callbacks to the local application
# Use ngrok tunnel URL for Microsoft OAuth to work:
OFFICE365_REDIRECT_URI=https://aery.eu.ngrok.io/auth/microsoft/callback
# Or use local URL (OAuth won't work, but app will run):
# OFFICE365_REDIRECT_URI=http://mail.loc/auth/microsoft/callback
OFFICE365_SCOPES="openid,profile,email,offline_access,Mail.Read"

# ngrok Tunnel Configuration (for Microsoft OAuth testing)
# ngrok creates a public tunnel to your local application
# This allows Microsoft's OAuth servers to reach your callback URL
#
# Setup:
# 1. Start ngrok: ngrok http --domain=aery.eu.ngrok.io --host-header=rewrite mail.loc:80
# 2. Add redirect URI in Azure: https://aery.eu.ngrok.io/auth/microsoft/callback
# 3. Keep APP_URL as http://mail.loc (application still runs locally)
# 4. Update OFFICE365_REDIRECT_URI above to use the ngrok URL
#
# Trusted Proxies:
# The application is configured to trust all proxies (*) by default.
# This is required for ngrok to properly forward request headers.
# Laravel will trust X-Forwarded-* headers from ngrok to maintain sessions.
# Configuration is in bootstrap/app.php and app/Http/Middleware/TrustProxies.php
#
# See NGROK_SETUP.md for detailed instructions
